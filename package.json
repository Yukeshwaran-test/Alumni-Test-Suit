{
  "name": "automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-report.ps1",
    "sf:login": "tsx scripts/sf-login.ts",
    "test:events": "playwright test --project=events",
    "test:events:headed": "playwright test --project=events --headed",
    "test:events:no-approval": "playwright test --project=events --grep-invert @sf-approval",
    "test:events:watch": "cross-env SLOWMO=500 playwright test --project=events --grep-invert @sf-approval --headed --workers=1",
    "test:events:live": "cross-env SLOWMO=500 PW_TEST_HTML_REPORT_OPEN=always playwright test --project=events --grep-invert @sf-approval --headed --workers=1",
    "test:network": "playwright test --project=network",
    "test:modules": "playwright test --project=modules",
    "test:mentorship": "playwright test tests/modules/mentorship.spec.ts --project=modules",
    "test:fundraise": "playwright test tests/modules/fundraise.spec.ts --project=modules",
    "test:groups": "playwright test tests/modules/groups.spec.ts --project=modules",
    "test:business": "playwright test tests/modules/business-directory.spec.ts --project=modules",
    "test:survey": "playwright test tests/modules/feedback-survey.spec.ts --project=modules",
    "test:support": "playwright test tests/modules/service-support.spec.ts --project=modules",
    "report:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/zip-report.ps1",
    "test:validation": "playwright test tests/modules/validation --project=modules",
    "test:edge": "playwright test tests/modules/edge --project=modules",
    "test:registration": "playwright test --project=registration",
    "test:registration:validation": "playwright test tests/registration/registration.validation.spec.ts --project=registration",
    "test:registration:e2e": "playwright test tests/registration/registration.e2e.spec.ts --project=registration --workers=1",
    "test:registration:headed": "playwright test --project=registration --headed --workers=1",
    "report:excel": "tsx scripts/excel-report.ts",
    "test:all": "playwright test & tsx scripts/excel-report.ts",
    "test:all-modules": "tsx scripts/run-modules.ts",
    "check:login": "tsx scripts/check-login.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
